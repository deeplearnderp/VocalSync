<UserControl x:Class="VocalSync.Views.AnalysisPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Foreground="#FFFFFFFF">

    <Grid Margin="0,10,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="160"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Vertical">
                <TextBlock x:Name="FileNameText"
                           FontFamily="Segoe UI"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#FFCCCCCC"
                           Text="—"/>
                <TextBlock x:Name="StatsText"
                           FontFamily="Segoe UI"
                           FontSize="10"
                           Foreground="#FF666666"
                           Margin="0,2,0,0"
                           Text="Select a recording in the library"/>
            </StackPanel>

            <Border Grid.Column="1"
                    Background="#FF1A1A1A"
                    BorderBrush="#FF2A2A2A"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10,4"
                    VerticalAlignment="Center">
                <TextBlock x:Name="VoicedBadge"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           Foreground="#FF888888"
                           Text="—"/>
            </Border>
        </Grid>

        <!-- Pitch graph -->
        <Border Grid.Row="1"
                Background="#FF121212"
                CornerRadius="6"
                ClipToBounds="True">
            <Image x:Name="GraphImage"
                   Stretch="Fill"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        </Border>

        <!-- Legend -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
            <Ellipse Width="8" Height="8" Fill="#FF1DB954" Margin="0,0,4,0" VerticalAlignment="Center"/>
            <TextBlock Text="Voiced (high confidence)"
                       FontFamily="Segoe UI" FontSize="10" Foreground="#FF555555" Margin="0,0,16,0" VerticalAlignment="Center"/>
            <Ellipse Width="8" Height="8" Fill="#FF555555" Margin="0,0,4,0" VerticalAlignment="Center"/>
            <TextBlock Text="Voiced (low confidence)"
                       FontFamily="Segoe UI" FontSize="10" Foreground="#FF555555" Margin="0,0,16,0" VerticalAlignment="Center"/>
            <Rectangle Width="20" Height="2" Fill="#FF1E1E1E" Margin="0,0,4,0" VerticalAlignment="Center"/>
            <TextBlock Text="Semitone grid"
                       FontFamily="Segoe UI" FontSize="10" Foreground="#FF555555" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Correction panel -->
        <Border Grid.Row="3"
                Background="#FF0A0A0A"
                BorderBrush="#FF1E1E1E"
                BorderThickness="1"
                CornerRadius="6"
                Margin="0,10,0,0"
                Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0"
                              x:Name="CorrectionToggle"
                              IsChecked="False"
                              VerticalAlignment="Center"
                              Checked="CorrectionToggle_Changed"
                              Unchecked="CorrectionToggle_Changed">
                        <CheckBox.Content>
                            <TextBlock Text="PITCH CORRECTION"
                                       FontFamily="Segoe UI" FontSize="9" FontWeight="SemiBold"
                                       Foreground="#FF666666"/>
                        </CheckBox.Content>
                    </CheckBox>

                    <TextBlock Grid.Column="1"
                               Text="  ·  prototype quality — robotic artefacts expected"
                               FontFamily="Segoe UI" FontSize="9" FontStyle="Italic"
                               Foreground="#FF333333" VerticalAlignment="Center"/>
                </Grid>

                <Grid Grid.Row="1" x:Name="CorrectionControlsGrid" IsEnabled="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Strength"
                               FontFamily="Segoe UI" FontSize="10"
                               Foreground="#FF666666" VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

                    <Slider Grid.Column="1"
                            x:Name="StrengthSlider"
                            Minimum="0" Maximum="1" Value="1"
                            VerticalAlignment="Center"
                            TickFrequency="0.25" IsSnapToTickEnabled="False"/>

                    <TextBlock Grid.Column="2"
                               x:Name="StrengthLabel"
                               Text="100%"
                               FontFamily="Segoe UI" FontSize="10"
                               Foreground="#FF555555" VerticalAlignment="Center"
                               Margin="6,0,0,0" MinWidth="34"/>

                    <Button Grid.Column="4"
                            x:Name="RenderButton"
                            Content="⚙ Render Corrected WAV"
                            Click="RenderButton_Click"
                            Height="26">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background"      Value="#FF1E1E1E"/>
                                <Setter Property="Foreground"      Value="#FF888888"/>
                                <Setter Property="BorderBrush"     Value="#FF2A2A2A"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="FontFamily"      Value="Segoe UI"/>
                                <Setter Property="FontSize"        Value="11"/>
                                <Setter Property="Cursor"          Value="Hand"/>
                                <Setter Property="Padding"         Value="10,0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="4" Height="{TemplateBinding Height}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#FF2A2A2A"/>
                                                    <Setter Property="Foreground" Value="#FFBBBBBB"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.4"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Grid.Column="6"
                            x:Name="PlayCorrectedButton"
                            Content="▶ Play Corrected"
                            IsEnabled="False"
                            Click="PlayCorrectedButton_Click"
                            Height="26">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background"      Value="#FF1E1E1E"/>
                                <Setter Property="Foreground"      Value="#FF1DB954"/>
                                <Setter Property="BorderBrush"     Value="#FF2A2A2A"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="FontFamily"      Value="Segoe UI"/>
                                <Setter Property="FontSize"        Value="11"/>
                                <Setter Property="Cursor"          Value="Hand"/>
                                <Setter Property="Padding"         Value="10,0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="4" Height="{TemplateBinding Height}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#FF2A2A2A"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.35"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ProgressBar x:Name="RenderProgress"
                                 Grid.Column="0"
                                 Height="3"
                                 Minimum="0" Maximum="1" Value="0"
                                 Background="#FF1E1E1E"
                                 Foreground="#FF1DB954"
                                 BorderThickness="0"
                                 Visibility="Collapsed"
                                 VerticalAlignment="Center"/>

                    <TextBlock x:Name="CorrectionStatus"
                               Grid.Column="1"
                               Text="Enable correction above to render"
                               FontFamily="Segoe UI" FontSize="10"
                               Foreground="#FF444444"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
