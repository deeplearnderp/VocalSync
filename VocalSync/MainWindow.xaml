<Window x:Class="VocalSync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VocalSync"
        xmlns:views="clr-namespace:VocalSync.Views"
        xmlns:models="clr-namespace:VocalSync.Models"
        mc:Ignorable="d"
        Title="VocalSync"
        Height="860" Width="1040"
        MinHeight="640" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="#FF121212"
        Foreground="#FFFFFFFF">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:InverseBoolConverter x:Key="InverseBool"/>

        <!-- Dark button style (unchanged) -->
        <Style x:Key="ToggleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF1DB954"/>
            <Setter Property="Foreground" Value="#FF000000"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="160"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="24"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF17A349"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FF138A3C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Device selector ComboBox style -->
        <Style x:Key="DeviceComboStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#FF1E1E1E"/>
            <Setter Property="Foreground" Value="#FFBBBBBB"/>
            <Setter Property="BorderBrush" Value="#FF2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="IsEditable" Value="False"/>
        </Style>

        <!-- Small icon-style refresh button -->
        <Style x:Key="RefreshButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF1E1E1E"/>
            <Setter Property="Foreground" Value="#FF888888"/>
            <Setter Property="BorderBrush" Value="#FF2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Refresh device list"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF2A2A2A"/>
                                <Setter Property="Foreground" Value="#FFCCCCCC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FF333333"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Level meter ProgressBar style -->
        <Style x:Key="LevelMeterStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Margin" Value="18,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#FF1E1E1E"/>
            <Setter Property="Foreground" Value="#FF1DB954"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="3"/>
                            <Border x:Name="PART_Track"/>
                            <Border x:Name="PART_Indicator"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="3"
                                    HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Live / workspace divider -->
        <Style x:Key="WorkspaceSplitterStyle" TargetType="GridSplitter">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="#FF252525"/>
            <Setter Property="BorderBrush" Value="#FF1A1A1A"/>
            <Setter Property="BorderThickness" Value="0,1,0,1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Cursor" Value="SizeNS"/>
        </Style>
    </Window.Resources>

    <!-- Root: library (live workspace) + main column (live capture + embedded analysis) -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" MinWidth="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Recording library -->
        <Border Grid.Column="0"
                Margin="12,12,8,12"
                Padding="10,10,10,10"
                Background="#FF0D0D0D"
                BorderBrush="#FF1E1E1E"
                BorderThickness="1"
                CornerRadius="8">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top"
                           Text="RECORDINGS"
                           FontFamily="Segoe UI"
                           FontSize="9"
                           FontWeight="SemiBold"
                           Foreground="#FF444444"
                           Margin="2,0,0,8"/>
                <ListBox ItemsSource="{Binding Recordings}"
                         SelectedItem="{Binding SelectedRecording}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.Resources>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="Margin" Value="0,0,0,4"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd"
                                                Background="Transparent"
                                                CornerRadius="4"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#FF1A1A1A"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#FF142818"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF1DB954"/>
                                                <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.Resources>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:RecordingEntry}">
                            <StackPanel>
                                <TextBlock Text="{Binding FileName}"
                                           FontFamily="Segoe UI"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#FFCCCCCC"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding FilePath}"/>
                                <TextBlock Text="{Binding SummaryLine}"
                                           FontFamily="Segoe UI"
                                           FontSize="9"
                                           Foreground="#FF555555"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="320"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="*" MinHeight="280"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="36"/>
            </Grid.RowDefinitions>

            <!-- LIVE: fixed-height dashboard row; top-aligned content -->
            <Grid Grid.Row="0"
                  VerticalAlignment="Top"
                  ClipToBounds="True"
                  MinHeight="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

        <!-- App title + gear button (same row, overlaid) -->
        <TextBlock Grid.Row="0"
                   Text="VOCALSYNC"
                   FontFamily="Segoe UI"
                   FontSize="12"
                   FontWeight="Bold"
                   Foreground="#FF888888"
                   HorizontalAlignment="Center"
                   Margin="0,4,0,0"/>

        <Button Grid.Row="0"
                x:Name="SettingsButton"
                Content="⚙"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Width="32" Height="32"
                Margin="0,2,12,0"
                FontSize="15"
                Cursor="Hand"
                ToolTip="Settings"
                Click="SettingsButton_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background"      Value="Transparent"/>
                    <Setter Property="Foreground"      Value="#FF444444"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FF1E1E1E"/>
                                        <Setter Property="Foreground" Value="#FF888888"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#FF2A2A2A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>

        <!-- Note display (compact) -->
        <TextBlock Grid.Row="1"
                   Text="{Binding NoteName}"
                   FontFamily="Segoe UI Light"
                   FontSize="52"
                   FontWeight="Light"
                   Foreground="#FFFFFFFF"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextAlignment="Center"
                   Margin="0,-4,0,-2"/>

        <!-- Frequency readout + active dot -->
        <Grid Grid.Row="2" Margin="0,0,0,2">
            <TextBlock Text="{Binding FrequencyText}"
                       FontFamily="Segoe UI"
                       FontSize="16"
                       Foreground="#FF888888"
                       HorizontalAlignment="Center"/>
            <Ellipse Width="6" Height="6"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Bottom"
                     Margin="0,0,0,-6"
                     Fill="#FF1DB954"
                     Visibility="{Binding IsRunning,
                                  Converter={StaticResource BoolToVisibility}}"/>
        </Grid>

        <!-- Level meter -->
        <StackPanel Grid.Row="3" Margin="0,1,0,2">
            <TextBlock Text="INPUT LEVEL"
                       FontFamily="Segoe UI"
                       FontSize="9"
                       FontWeight="SemiBold"
                       Foreground="#FF444444"
                       HorizontalAlignment="Left"
                       Margin="18,0,0,1"/>
            <ProgressBar x:Name="LevelMeter"
                         Style="{StaticResource LevelMeterStyle}"
                         Minimum="0" Maximum="1"
                         Value="{Binding InputLevel, Mode=OneWay}"/>
        </StackPanel>

        <!-- Waveform visualizer -->
        <Border Grid.Row="4"
                Height="36"
                MinHeight="36"
                MaxHeight="36"
                Margin="14,0,14,2"
                CornerRadius="6"
                Background="#FF080808"
                BorderBrush="#FF262626"
                BorderThickness="1"
                Padding="2"
                ClipToBounds="True"
                SnapsToDevicePixels="True">
            <Border Background="#FF0D0D0D"
                    CornerRadius="4"
                    ClipToBounds="True">
            <views:SignalVisualizer x:Name="Visualizer"/>
            </Border>
        </Border>

        <!-- Device selector -->
        <Grid Grid.Row="5" Margin="14,2,14,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="INPUT"
                       FontFamily="Segoe UI"
                       FontSize="9"
                       FontWeight="SemiBold"
                       Foreground="#FF444444"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

            <ComboBox Grid.Column="1"
                      x:Name="DeviceComboBox"
                      Style="{StaticResource DeviceComboStyle}"
                      ItemsSource="{Binding AvailableDevices}"
                      SelectedItem="{Binding SelectedDevice}"
                      IsEnabled="{Binding IsRunning,
                                  Converter={StaticResource InverseBool}}"/>

            <Button Grid.Column="2"
                    x:Name="RefreshButton"
                    Style="{StaticResource RefreshButtonStyle}"
                    Content="↻"
                    Margin="6,0,0,0"
                    IsEnabled="{Binding IsRunning,
                                Converter={StaticResource InverseBool}}"
                    Click="RefreshButton_Click"/>
        </Grid>

        <!-- Monitor controls -->
        <!-- ⚠ Use headphones to avoid microphone feedback when monitoring is enabled -->
        <Grid Grid.Row="6" Margin="14,1,14,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="MONITOR"
                       FontFamily="Segoe UI"
                       FontSize="9"
                       FontWeight="SemiBold"
                       Foreground="#FF444444"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

            <!-- Monitor enable toggle -->
            <CheckBox Grid.Column="1"
                      IsChecked="{Binding IsMonitoring}"
                      VerticalAlignment="Center"
                      Margin="0,0,12,0"
                      ToolTip="⚠ Use headphones to avoid feedback">
                <CheckBox.Style>
                    <Style TargetType="CheckBox">
                        <Setter Property="Foreground" Value="#FF888888"/>
                        <Setter Property="FontFamily" Value="Segoe UI"/>
                        <Setter Property="FontSize" Value="11"/>
                    </Style>
                </CheckBox.Style>
            </CheckBox>

            <!-- Volume slider — only meaningful when monitor is on -->
            <Slider Grid.Column="2"
                    Minimum="0" Maximum="1"
                    Value="{Binding MonitorVolume}"
                    VerticalAlignment="Center"
                    IsEnabled="{Binding IsMonitoring}"
                    ToolTip="Monitor output volume"/>

            <!-- Volume percentage label -->
            <TextBlock Grid.Column="3"
                       Text="{Binding MonitorVolume, StringFormat={}{0:P0}}"
                       FontFamily="Segoe UI"
                       FontSize="10"
                       Foreground="#FF555555"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0"
                       MinWidth="36"/>
        </Grid>

        <!-- Recording controls (live) — playback uses library selection or last take -->
        <Grid Grid.Row="7" Margin="14,1,14,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="REC"
                       FontFamily="Segoe UI"
                       FontSize="9"
                       FontWeight="SemiBold"
                       Foreground="#FF444444"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

            <!-- Record / Stop record button -->
            <Button Grid.Column="1"
                    Content="{Binding RecordButtonLabel}"
                    IsEnabled="{Binding CanRecord}"
                    Click="RecordButton_Click"
                    Margin="0,0,6,0"
                    ToolTip="Start/stop WAV recording">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background"      Value="#FF1E1E1E"/>
                        <Setter Property="Foreground"      Value="#FFE5533D"/>
                        <Setter Property="BorderBrush"     Value="#FF2A2A2A"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="FontFamily"      Value="Segoe UI"/>
                        <Setter Property="FontSize"        Value="11"/>
                        <Setter Property="FontWeight"      Value="SemiBold"/>
                        <Setter Property="Width"           Value="62"/>
                        <Setter Property="Height"          Value="26"/>
                        <Setter Property="Cursor"          Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FF2A2A2A"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.35"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <!-- Pulse background red while recording -->
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                <Setter Property="Background" Value="#FF3A0A0A"/>
                                <Setter Property="BorderBrush" Value="#FFE5533D"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Play / Stop playback (original WAV for current target) -->
            <Button Grid.Column="2"
                    Content="{Binding PlayButtonLabel}"
                    IsEnabled="{Binding CanPlayback}"
                    Click="PlayButton_Click"
                    Margin="0,0,6,0"
                    ToolTip="Play selected library item, or last recording if none selected">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background"      Value="#FF1E1E1E"/>
                        <Setter Property="Foreground"      Value="#FF1DB954"/>
                        <Setter Property="BorderBrush"     Value="#FF2A2A2A"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="FontFamily"      Value="Segoe UI"/>
                        <Setter Property="FontSize"        Value="11"/>
                        <Setter Property="FontWeight"      Value="SemiBold"/>
                        <Setter Property="Width"           Value="62"/>
                        <Setter Property="Height"          Value="26"/>
                        <Setter Property="Cursor"          Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FF2A2A2A"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.35"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Playback target (selection or last take) -->
            <TextBlock Grid.Column="3"
                       Text="{Binding PlaybackFileNameDisplay}"
                       FontFamily="Segoe UI"
                       FontSize="10"
                       Foreground="#FF444444"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="10,0,0,0"
                       ToolTip="{Binding PlaybackTargetPath}"/>
        </Grid>
            </Grid>

            <!-- Adjustable split: live (above) vs analysis workspace (below) -->
            <GridSplitter Grid.Row="1"
                          Style="{StaticResource WorkspaceSplitterStyle}"
                          ResizeDirection="Rows"
                          ShowsPreview="False"/>

            <!-- Workspace: analysis + correction (dominant vertical share) -->
            <Border Grid.Row="2"
                    Margin="8,0,8,0"
                    Padding="8,0,8,0"
                    Background="Transparent"
                    ClipToBounds="True">
                <views:AnalysisPanel x:Name="WorkspacePanel" VerticalAlignment="Stretch"/>
            </Border>

            <!-- Start/Stop capture -->
            <Button Grid.Row="3"
                    Content="{Binding ToggleButtonLabel}"
                    Style="{StaticResource ToggleButtonStyle}"
                    HorizontalAlignment="Center"
                    Margin="0,4,0,0"
                    Click="ToggleButton_Click"/>

            <!-- Status text -->
            <TextBlock Grid.Row="4"
                       Text="{Binding StatusText}"
                       FontFamily="Segoe UI"
                       FontSize="11"
                       Foreground="#FF555555"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
