<UserControl x:Class="VocalSync.Views.AnalysisPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Foreground="#FFFFFFFF">

    <!-- Correction docked bottom. Header + timeline + graph + legend fill remaining height (no scroll). -->
    <DockPanel Margin="0,2,0,0" LastChildFill="True">

        <!-- CONTROL AREA: always measured first, stays visible at bottom of panel -->
        <Border DockPanel.Dock="Bottom"
                Background="#FF0A0A0A"
                BorderBrush="#FF262626"
                BorderThickness="1"
                CornerRadius="6"
                Margin="0,8,0,0"
                Padding="14,12"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0"
                              x:Name="CorrectionToggle"
                              IsChecked="False"
                              VerticalAlignment="Center"
                              Checked="CorrectionToggle_Changed"
                              Unchecked="CorrectionToggle_Changed">
                        <CheckBox.Content>
                            <TextBlock Text="PITCH CORRECTION"
                                       FontFamily="Segoe UI" FontSize="9" FontWeight="SemiBold"
                                       Foreground="#FF666666"/>
                        </CheckBox.Content>
                    </CheckBox>

                    <TextBlock Grid.Column="1"
                               Text="  ·  prototype quality — robotic artefacts expected"
                               FontFamily="Segoe UI" FontSize="9" FontStyle="Italic"
                               Foreground="#FF333333" VerticalAlignment="Center"/>
                </Grid>

                <Grid Grid.Row="1" x:Name="CorrectionControlsGrid" IsEnabled="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Strength"
                               FontFamily="Segoe UI" FontSize="10"
                               Foreground="#FF666666" VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

                    <Slider Grid.Column="1"
                            x:Name="StrengthSlider"
                            Minimum="0" Maximum="1" Value="1"
                            VerticalAlignment="Center"
                            TickFrequency="0.25" IsSnapToTickEnabled="False"/>

                    <TextBlock Grid.Column="2"
                               x:Name="StrengthLabel"
                               Text="100%"
                               FontFamily="Segoe UI" FontSize="10"
                               Foreground="#FF555555" VerticalAlignment="Center"
                               Margin="6,0,0,0" MinWidth="34"/>

                    <Button Grid.Column="4"
                            x:Name="RenderButton"
                            Content="⚙ Render Corrected WAV"
                            Click="RenderButton_Click"
                            Height="26">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background"      Value="#FF1E1E1E"/>
                                <Setter Property="Foreground"      Value="#FF888888"/>
                                <Setter Property="BorderBrush"     Value="#FF2A2A2A"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="FontFamily"      Value="Segoe UI"/>
                                <Setter Property="FontSize"        Value="11"/>
                                <Setter Property="Cursor"          Value="Hand"/>
                                <Setter Property="Padding"         Value="10,0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="4" Height="{TemplateBinding Height}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#FF2A2A2A"/>
                                                    <Setter Property="Foreground" Value="#FFBBBBBB"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.4"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Grid.Column="6"
                            x:Name="PlayCorrectedButton"
                            Content="▶ Play Corrected"
                            IsEnabled="False"
                            Click="PlayCorrectedButton_Click"
                            Height="26">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background"      Value="#FF1E1E1E"/>
                                <Setter Property="Foreground"      Value="#FF1DB954"/>
                                <Setter Property="BorderBrush"     Value="#FF2A2A2A"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="FontFamily"      Value="Segoe UI"/>
                                <Setter Property="FontSize"        Value="11"/>
                                <Setter Property="Cursor"          Value="Hand"/>
                                <Setter Property="Padding"         Value="10,0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="4" Height="{TemplateBinding Height}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#FF2A2A2A"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.35"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <Grid Grid.Row="2" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ProgressBar x:Name="RenderProgress"
                                 Grid.Column="0"
                                 Height="3"
                                 Minimum="0" Maximum="1" Value="0"
                                 Background="#FF1E1E1E"
                                 Foreground="#FF1DB954"
                                 BorderThickness="0"
                                 Visibility="Collapsed"
                                 VerticalAlignment="Center"/>

                    <TextBlock x:Name="CorrectionStatus"
                               Grid.Column="1"
                               Text="Enable correction above to render"
                               FontFamily="Segoe UI" FontSize="10"
                               Foreground="#FF444444"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"/>
                </Grid>
            </Grid>
        </Border>

        <!-- HEADER + timeline + GRAPH + LEGEND -->
        <!-- DEBUG: Background="#2200FF00" = semi-transparent green on the outer grid -->
        <Grid x:Name="OuterLayoutGrid" UseLayoutRounding="True"
              Background="#2200FF00">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <!-- DEBUG Phase 1: was Height="*" MinHeight="160" — forced fixed to prove star sizing -->
                <RowDefinition Height="300"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,6" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Top">
                        <TextBlock x:Name="FileNameText"
                                   FontFamily="Segoe UI"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#FFCCCCCC"
                                   TextTrimming="CharacterEllipsis"
                                   Text="—"/>
                        <ScrollViewer Margin="0,2,0,0"
                                      MaxHeight="72"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="StatsText"
                                       FontFamily="Segoe UI"
                                       FontSize="10"
                                       Foreground="#FF666666"
                                       TextWrapping="Wrap"
                                       Text="Select a recording in the library"/>
                        </ScrollViewer>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="#FF1A1A1A"
                            BorderBrush="#FF333333"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,5"
                            VerticalAlignment="Top">
                        <TextBlock x:Name="VoicedBadge"
                                   FontFamily="Segoe UI"
                                   FontSize="11"
                                   Foreground="#FF888888"
                                   Text="—"/>
                    </Border>
                </Grid>

                <!-- Timeline strip: code-driven ticks via TimelineCanvas -->
                <Border Grid.Row="1"
                        Height="22"
                        Margin="0,2,0,0"
                        Background="#FF151515"
                        BorderBrush="#FF2C2C2C"
                        BorderThickness="1"
                        CornerRadius="4,4,0,0"
                        SnapsToDevicePixels="True"
                        ClipToBounds="True">
                    <Canvas x:Name="TimelineCanvas"
                            IsHitTestVisible="False"
                            SizeChanged="TimelineCanvas_SizeChanged"/>
                </Border>

                <!-- Graph: framed plot area -->
                <!-- DEBUG Phase 2: Height="300" MinHeight="300" forced; Background="#22FF0000" red debug -->
                <Border x:Name="GraphBorder"
                        Grid.Row="2"
                        Background="#22FF0000"
                        BorderBrush="#FF383838"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="2"
                        ClipToBounds="True"
                        VerticalAlignment="Stretch"
                        HorizontalAlignment="Stretch"
                        Height="300"
                        MinHeight="300"
                        SnapsToDevicePixels="True">
                    <Border Background="#FF111111"
                            CornerRadius="4"
                            ClipToBounds="True">
                        <!-- Graph stack: bitmap image + note-label overlay + playhead overlay Canvas -->
                        <!-- DEBUG Phase 4: blue background on GraphContentGrid -->
                        <Grid x:Name="GraphContentGrid"
                              Background="#220000FF">
                            <!-- DEBUG Phase 3: Width/Height forced; Phase 4: cyan Background on Image -->
                            <Image x:Name="GraphImage"
                                   Stretch="Fill"
                                   Width="600"
                                   Height="300"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            <!-- Octave note labels overlay (C3, C4…) — sits between graph and playhead -->
                            <Canvas x:Name="NoteLabelsCanvas"
                                    IsHitTestVisible="False"/>
                            <!-- Playhead overlay: clipped to graph bounds automatically by parent ClipToBounds -->
                            <Canvas x:Name="PlayheadCanvas"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed">
                                <!-- Soft glow: wider, dim, behind the sharp line -->
                                <Line x:Name="PlayheadGlow"
                                      Y1="0" Y2="2000"
                                      Stroke="#40FFFFFF"
                                      StrokeThickness="3"
                                      IsHitTestVisible="False"/>
                                <!-- Sharp cursor line -->
                                <Line x:Name="PlayheadLine"
                                      Y1="0" Y2="2000"
                                      Stroke="#FFFFFFFF"
                                      StrokeThickness="1"
                                      IsHitTestVisible="False"
                                      SnapsToDevicePixels="True"/>
                            </Canvas>
                        </Grid>
                    </Border>
                </Border>

                <!-- Legend: compact overlay-style strip -->
                <Border Grid.Row="3"
                        Background="#FF141414"
                        BorderBrush="#FF252525"
                        BorderThickness="0,1,0,0"
                        Padding="4,4,4,2"
                        Margin="0,0,0,0"
                        SnapsToDevicePixels="True">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="#FF1DB954" Margin="0,0,3,0" VerticalAlignment="Center"/>
                    <TextBlock Text="High conf."
                               FontFamily="Segoe UI" FontSize="9" Foreground="#FF666666" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <Ellipse Width="7" Height="7" Fill="#FF555555" Margin="0,0,3,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Low conf."
                               FontFamily="Segoe UI" FontSize="9" Foreground="#FF666666" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <Rectangle Width="16" Height="2" Fill="#FF2A2A2A" Margin="0,0,3,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Grid"
                               FontFamily="Segoe UI" FontSize="9" Foreground="#FF666666" VerticalAlignment="Center"/>
                </StackPanel>
                </Border>
        </Grid>
    </DockPanel>
</UserControl>
