<Window x:Class="VocalSync.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VocalSync — Settings"
        Width="400" Height="200"
        MinWidth="340" MinHeight="180"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#FF121212"
        Foreground="#FFFFFFFF"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <!-- Reuse the same ComboBox look as the main window -->
        <Style x:Key="SettingsComboStyle" TargetType="ComboBox">
            <Setter Property="Background"       Value="#FF1E1E1E"/>
            <Setter Property="Foreground"       Value="#FFBBBBBB"/>
            <Setter Property="BorderBrush"      Value="#FF2A2A2A"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="FontFamily"       Value="Segoe UI"/>
            <Setter Property="FontSize"         Value="12"/>
            <Setter Property="Height"           Value="30"/>
            <Setter Property="Padding"          Value="8,0"/>
        </Style>

        <!-- OK button — matches main window green pill style but smaller -->
        <Style x:Key="OkButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="#FF1DB954"/>
            <Setter Property="Foreground"      Value="#FF000000"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"           Value="80"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="16"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF17A349"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FF138A3C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cancel button — ghost style -->
        <Style x:Key="CancelButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#FF666666"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"           Value="80"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="16"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FF999999"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- section label -->
            <RowDefinition Height="Auto"/>   <!-- output device row -->
            <RowDefinition Height="*"/>      <!-- spacer -->
            <RowDefinition Height="Auto"/>   <!-- buttons -->
        </Grid.RowDefinitions>

        <!-- Section label -->
        <TextBlock Grid.Row="0"
                   Text="OUTPUT DEVICE"
                   FontFamily="Segoe UI"
                   FontSize="9"
                   FontWeight="SemiBold"
                   Foreground="#FF444444"
                   Margin="0,0,0,8"/>

        <!-- Output device ComboBox -->
        <ComboBox Grid.Row="1"
                  x:Name="OutputDeviceCombo"
                  Style="{StaticResource SettingsComboStyle}"
                  ItemsSource="{Binding AvailableOutputDevices}"
                  SelectedItem="{Binding SelectedOutputDevice}"/>

        <!-- Feedback note -->
        <TextBlock Grid.Row="2"
                   Text="⚠  Use headphones to avoid microphone feedback"
                   FontFamily="Segoe UI"
                   FontSize="10"
                   Foreground="#FF555555"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,4"/>

        <!-- OK / Cancel -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Style="{StaticResource CancelButtonStyle}"
                    Margin="0,0,8,0"
                    Click="CancelButton_Click"/>
            <Button Content="OK"
                    Style="{StaticResource OkButtonStyle}"
                    IsDefault="True"
                    Click="OkButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
